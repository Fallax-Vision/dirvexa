<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dirvexa.App.ViewModels"
             x:Class="Dirvexa.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <Grid MaxWidth="820" Margin="24" VerticalAlignment="Center">
    <Border Classes="card" Padding="20" MinHeight="440">
      <Grid RowDefinitions="Auto,14,*,16,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Previous Scans" Classes="page-title" />
            <TextBlock Text="The newest 20 snapshots are stored locally." Classes="muted" FontSize="10" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Scans.Count, StringFormat='{}{0} saved'}"
                     Classes="muted" FontSize="10" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Classes="subtle-card" Padding="8" IsVisible="{Binding HasScans}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Scans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScanListItemViewModel">
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9">
                    <Grid ColumnDefinitions="2*,1*,1.15*,Auto" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="{Binding RootPath}" Classes="muted" FontSize="9"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Size}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Counts}" Classes="muted" FontSize="9" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="{Binding Completed}" Classes="muted" FontSize="9" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Width="66" Content="Open" Command="{Binding $parent[UserControl].DataContext.OpenCommand}" CommandParameter="{Binding}" />
                        <Button Width="66" Classes="quiet" Content="Delete" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" IsVisible="{Binding !HasScans}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
          <TextBlock Text="No previous scans" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Completed and kept partial scans will appear here." Classes="muted" FontSize="10" />
        </StackPanel>

        <Button Grid.Row="4" Classes="danger" Content="Clear History" Command="{Binding ClearCommand}"
                IsEnabled="{Binding HasScans}" HorizontalAlignment="Left" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
