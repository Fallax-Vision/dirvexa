<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dirvexa.App.ViewModels"
             xmlns:icons="using:FluentIcons.Avalonia"
             x:Class="Dirvexa.App.Views.ScanLandingView"
             x:DataType="vm:ScanLandingViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid MaxWidth="640" Margin="24" VerticalAlignment="Center">
      <Border Classes="card" Padding="24">
        <StackPanel Spacing="18">
          <TextBlock Text="Paste path to scan" Classes="page-title" HorizontalAlignment="Center" />

          <StackPanel Spacing="7">
            <TextBlock Text="Local folder or drive" Classes="muted" FontSize="10" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding PathInput}" PlaceholderText="Paste path here..."
                       MinHeight="40" MaxHeight="92" Padding="13,9"
                       AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       VerticalContentAlignment="Top" KeyDown="OnPathInputKeyDown"
                       AutomationProperties.Name="Folder path" />
              <Button Grid.Column="1" MinWidth="104" Command="{Binding BrowseCommand}" ToolTip.Tip="Choose folder"
                      MinHeight="40" VerticalAlignment="Top" AutomationProperties.Name="Choose a folder">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <icons:FluentIcon Icon="FolderOpen" IconVariant="Regular" FontSize="15" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="10"
                       IsVisible="{Binding HasError}" TextWrapping="Wrap" />
          </StackPanel>

          <Button Classes="primary" Command="{Binding StartCommand}" HorizontalAlignment="Center"
                  IsEnabled="{Binding !IsStarting}" AutomationProperties.Name="Start scan"
                  Content="Scan Path" MinWidth="104" />

          <Border Height="1" Background="{DynamicResource BorderBrush}" />

          <StackPanel IsVisible="{Binding HasRecentScans}" Spacing="7">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Recent Scans:" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="link" Content="View All" Command="{Binding ViewAllCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding RecentScans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScanListItemViewModel">
                  <Button Classes="quiet" Padding="0,4" HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[UserControl].DataContext.OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" />
                        <TextBlock Text="·" Classes="muted" FontSize="10" />
                        <TextBlock Text="{Binding RootPath}" Classes="muted" FontSize="10"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RootPath}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Completed}" FontSize="10"
                                 Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Classes="subtle-card" Padding="12" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <icons:FluentIcon Icon="ShieldCheckmark" IconVariant="Regular" FontSize="14"
                                Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Text="Offline and read-only. Scanned files never leave this PC."
                         Classes="muted" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
