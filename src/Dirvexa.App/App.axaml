<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dirvexa.App.ViewModels"
             xmlns:views="using:Dirvexa.App.Views"
             x:Class="Dirvexa.App.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ScanLandingViewModel}"><views:ScanLandingView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProgressViewModel}"><views:ProgressView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><views:ResultsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F4F4" />
          <SolidColorBrush x:Key="ChromeBrush" Color="#ECECEC" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E9E9E9" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#DEDEDE" />
          <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="InputHoverBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="BorderBrush" Color="#D2D2D2" />
          <SolidColorBrush x:Key="WindowBorderBrush" Color="#BDBDBD" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#171717" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666A68" />
          <SolidColorBrush x:Key="AccentBrush" Color="#07952C" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#057B24" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF2E3" />
          <SolidColorBrush x:Key="DangerBrush" Color="#B32630" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#F8E4E6" />
          <SolidColorBrush x:Key="WarningBrush" Color="#8D5D08" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackgroundBrush" Color="#000000" />
          <SolidColorBrush x:Key="ChromeBrush" Color="#0A0A0A" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#111111" />
          <SolidColorBrush x:Key="SurfaceAltBrush" Color="#202020" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#292929" />
          <SolidColorBrush x:Key="InputBrush" Color="#1B1B1B" />
          <SolidColorBrush x:Key="InputHoverBrush" Color="#232323" />
          <SolidColorBrush x:Key="BorderBrush" Color="#292929" />
          <SolidColorBrush x:Key="WindowBorderBrush" Color="#252525" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#919791" />
          <SolidColorBrush x:Key="AccentBrush" Color="#12E442" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#4AF16D" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#102D18" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F06A72" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#3B1115" />
          <SolidColorBrush x:Key="WarningBrush" Color="#E2AB43" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Segoe UI" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="-0.2" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.dialog-card"><Setter Property="CornerRadius" Value="12" /></Style>
    <Style Selector="Border.subtle-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.metric-tile">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.scan-status">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Padding" Value="5,3" />
    </Style>
    <Style Selector="Button.caption, ToggleButton.caption">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="41" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter, ToggleButton.caption:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.caption:checked">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.caption:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.settings-caption"><Setter Property="Width" Value="42" /></Style>
    <Style Selector="ToggleButton.nav">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ToggleButton.nav:checked">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton.nav:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment /template/ ContentPresenter">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment:checked">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox, ComboBox">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox:pointerover, ComboBox:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputHoverBrush}" />
    </Style>
    <Style Selector="TextBox:focus, ComboBox:focus">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ProgressBar.scan-progress">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Height" Value="7" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="DataGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="RowHeight" Value="34" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Style>
    <Style Selector="TreeView, TreeViewItem"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="TreeViewItem"><Setter Property="MinHeight" Value="30" /></Style>
  </Application.Styles>
</Application>
